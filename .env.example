# DefiLlama Pro API ($300/mo) — unlocks /overview/derivatives, /yields/perps, /emissions
# Key goes in URL path: https://pro-api.llama.fi/{KEY}/endpoint
# Use DEFILLAMA_API_KEY for server, VITE_DEFILLAMA_API_KEY for direct browser mode
DEFILLAMA_API_KEY=
VITE_DEFILLAMA_API_KEY=

# CoinGecko Pro — higher rate limits, uses x-cg-pro-api-key header
VITE_COINGECKO_API_KEY=

# Token Terminal (optional enrichment)
VITE_TT_API_KEY=

# CoinGlass — CEX futures volume data
COINGLASS_API_KEY=
